@if (!string.IsNullOrEmpty(Texto))
{
    <span class="chip p-3 h-auto position-relative start-50 translate-middle-x user-select-none"
          style="background-color: var(--bg-titulo); color: black; cursor: default;" role="alert">@Texto</span>
}

@code {
    [Parameter] public string? Texto { get; set; }
}
