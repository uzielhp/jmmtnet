@inject CobachJMMT.Services.AppsScriptService Script
@{
    var cfg = await Script.GetConfigAsync();
    var menuExamen = cfg?.Menu == true;
}
<!DOCTYPE html>
<html lang="es" data-bs-theme="dark" class="comprobando-conexion">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>COBACH JMMT</title>
  <link rel="icon" type="image/png" href="~/imgs/favicon.png" />
  <link rel="stylesheet" href="~/css/bootstrap-icons.min.css">
  <link rel="stylesheet" href="~/css/bootstrap.min.css">
  <link rel="stylesheet" href="~/css/principal.css" asp-append-version="true">
</head>
<body>
<div id="estadoConexion" class="estado-conexion" role="status" aria-live="polite">
  <p id="mensajeConexion">Comprobando conexión a Internet...</p>
  <div id="errorConexion" hidden>
    @await Html.PartialAsync("_ErrorMessage", "Acceso bloqueado mientras haya conexión a Internet.")
  </div>
  <button id="reintentarConexion" class="btn" type="button" hidden></button>
</div>
<nav class="fixed-top d-flex align-items-center gap-2 justify-content-between bg-black" style="height: 50px; padding: 0 5px;">
    <button class="nav-link d-inline-flex gap-2 bg-transparent border-0" type="button" data-bs-toggle="menu">
      <div class="contenedor-logo" id="logoC">
        <span class="d-inline-flex align-items-center hover-grupo py-1 rounded">
          <i class="bi bi-grid-3x3-gap-fill" style="padding-right: 5px"></i>
          <img class="logo" src="~/imgs/logo.png" alt="Logo" style="height: 30px; width: auto; padding-right: 5px">
        </span>
      </div>
    </button>    

    <div class="menu">
      <a class="menu-item" asp-page="/Index">Inicio</a>
      <div class="submenu">
        <button class="menu-item" type="button">Cultura Digital 1</button>
        <div class="menu">
          <a class="menu-item" asp-page="/Actividades/Act10">Act Contaminación digital</a>
        </div>
      </div>
      @if (menuExamen)
      {
        <hr class="menu-divider">
        @for (var i = 1; i <= 6; i++)
        {
          <a class="menu-item" asp-page="/Examen" asp-route-semestre="s@(i)00">Examen Semestre @i</a>
        }
      }
    </div>
    <a asp-page="/Admin/Index"><img src="~/imgs/adm.png" alt="Admin" height="35"></a>
  </nav>
  <div class="progress position-fixed start-0 w-100" role="progressbar" aria-label="Progreso del examen" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" style="top: 50px; height: 2px; z-index: 1029;">
    <div class="progress-bar" id="barraProgreso" style="width: 0%; background-color: var(--bg-titulo);"></div>
  </div>

  <main>
    @RenderBody()
  </main>

  @if (cfg is null)
  {
    <div class="text-center py-2 position-fixed bottom-0 start-0 w-100 text-white fw-medium shadow"
         style="background-color: var(--bg-titulo); z-index: 1060;">Error al conectarse Servidor</div>
  }
  @await RenderSectionAsync("Mensajes", required: false)

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const estado = document.getElementById("estadoConexion");
      const mensaje = document.getElementById("mensajeConexion");
      const errorConexion = document.getElementById("errorConexion");
      const reintentar = document.getElementById("reintentarConexion");
      let verificacion = 0;
      let comprobacionEnCurso = false;

      function permitirAccesoSinInternet() {
        document.documentElement.classList.remove("comprobando-conexion");
        estado.hidden = true;
      }

      async function comprobarInternet() {
        if (comprobacionEnCurso) return;

        const actual = ++verificacion;

        if (!navigator.onLine) {
          permitirAccesoSinInternet();
          return;
        }

        comprobacionEnCurso = true;
        const controlador = new AbortController();
        const tiempoLimite = setTimeout(() => controlador.abort(), 5000);

        try {
          await fetch("https://www.google.com/generate_204", {
            mode: "no-cors",
            cache: "no-store",
            signal: controlador.signal
          });

          if (actual === verificacion && navigator.onLine) {
            document.documentElement.classList.add("comprobando-conexion");
            estado.hidden = false;
            mensaje.hidden = true;
            errorConexion.hidden = false;
            reintentar.hidden = false;
          }
        } catch {
          if (actual === verificacion) {
            permitirAccesoSinInternet();
          }
        } finally {
          clearTimeout(tiempoLimite);
          comprobacionEnCurso = false;
        }
      }

      window.addEventListener("online", comprobarInternet);
      window.addEventListener("offline", () => {
        verificacion++;
        permitirAccesoSinInternet();
      });
      reintentar.textContent = "Volver a comprobar";
      reintentar.addEventListener("click", comprobarInternet);
      comprobarInternet();
      window.setInterval(comprobarInternet, 3000);
    });
  </script>

  <script type="module" src="~/js/bootstrap.bundle.min.js"></script>
</body>
</html>
