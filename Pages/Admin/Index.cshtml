@page
@model CobachJMMT.Pages.Admin.IndexModel

<div class="container" style="max-width: 720px;">
  <h3 class="text-center mb-3" style="color: var(--bg-titulo);">Administración</h3>

  @if (!string.IsNullOrEmpty(Model.Mensaje))
  {
    <div class="alert theme-success mb-3"><div>@Model.Mensaje</div></div>
  }

  @if (!Model.Autenticado)
  {
    <form method="post" asp-page-handler="Login" class="border rounded p-3" autocomplete="off">
      <label for="contra" class="col-form-label">Contraseña:</label>
      <input type="password" class="form-control @(Model.ErrorLogin is null ? "" : "is-invalid")"
             id="contra" name="contra" autocomplete="off" required autofocus>
      @if (Model.ErrorLogin is not null)
      {
        <div class="invalid-feedback">@Model.ErrorLogin</div>
      }
      <button type="submit" class="btn-solid theme-primary mt-3">Entrar</button>
    </form>
  }
  else
  {
    <form method="post" asp-page-handler="Guardar" class="border rounded p-3" autocomplete="off">
      @{
        var semestres = new[] { ("Primero", "S100"), ("Segundo", "S200"), ("Tercero", "S300"),
                                ("Cuarto", "S400"), ("Quinto", "S500"), ("Sexto", "S600") };
      }
      <div class="row mb-3"><label class="sm:col-2 col-form-label">Primero</label>
        <div class="sm:col-10"><input class="form-control" asp-for="Config.S100" autocomplete="off"></div></div>
      <div class="row mb-3"><label class="sm:col-2 col-form-label">Segundo</label>
        <div class="sm:col-10"><input class="form-control" asp-for="Config.S200" autocomplete="off"></div></div>
      <div class="row mb-3"><label class="sm:col-2 col-form-label">Tercero</label>
        <div class="sm:col-10"><input class="form-control" asp-for="Config.S300" autocomplete="off"></div></div>
      <div class="row mb-3"><label class="sm:col-2 col-form-label">Cuarto</label>
        <div class="sm:col-10"><input class="form-control" asp-for="Config.S400" autocomplete="off"></div></div>
      <div class="row mb-3"><label class="sm:col-2 col-form-label">Quinto</label>
        <div class="sm:col-10"><input class="form-control" asp-for="Config.S500" autocomplete="off"></div></div>
      <div class="row mb-3"><label class="sm:col-2 col-form-label">Sexto</label>
        <div class="sm:col-10"><input class="form-control" asp-for="Config.S600" autocomplete="off"></div></div>

      <div class="form-field mb-3">
        <input type="checkbox" class="check" asp-for="Config.Menu">
        <label asp-for="Config.Menu">Menu Examen</label>
      </div>
      <button type="submit" class="btn-solid theme-primary">Guardar</button>
    </form>

    <form method="post" asp-page-handler="Salir" class="mt-3 text-end">
      <button type="submit" class="btn-outline theme-secondary btn-sm">Cerrar sesión</button>
    </form>
  }
</div>